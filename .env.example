# Streak Open Source Environment Configuration Example
# Copy this file to .env and customize values for your own local build:
#   cp .env.example .env

# App Group Identifier for iOS Home Screen & Lock Screen Widgets
# Found in: Xcode > Target 'Streak' > Signing & Capabilities > App Groups
APP_GROUP_ID=group.com.madhvan.streak

# Background Processing Task Identifier
# Found in: Streak/Info.plist > BGTaskSchedulerPermittedIdentifiers
BACKGROUND_TASK_ID=com.madhvan.streak.lockoutSweep

# Active Day Cycle Boundaries (24-hour format, e.g. 4 = 4:00 AM, 23 = 11:00 PM)
ACTIVE_DAY_START_HOUR=4
ACTIVE_DAY_END_HOUR=23

# Planning Reminder Notification Defaults (24-hour format)
PLANNING_REMINDER_HOUR=22
PLANNING_REMINDER_MINUTE=0

# Default Notification Motivation Persona (Options: savage | drill | rpg | zen)
NOTIFICATION_PERSONA=savage

# Optional Gemini AI API Key for Dynamic Spicy Notifications
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=
